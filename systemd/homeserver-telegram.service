[Unit]
Description=Jarvis Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__WORKING_DIR__
ExecStart=__WORKING_DIR__/venv/bin/python services/telegram_bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
