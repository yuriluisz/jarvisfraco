# ==============================================================================
# JARVISFRACO - CONFIGURAÇÃO DE AMBIENTE (.env)
# ==============================================================================
# Renomeie este arquivo para .env e preencha com suas credenciais.
# NUNCA envie seu arquivo .env real para o GitHub ou compartilhe com terceiros!

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT (Controle Remoto, Fotos e Alertas do Sentinela)
# ------------------------------------------------------------------------------
# Crie seu bot no Telegram conversando com o @BotFather (comando /newbot).
# O BotFather vai te fornecer um token no formato: 1234567890:ABCdefGHIjklMNOpqrs
TELEGRAM_BOT_TOKEN="seu_token_do_telegram_aqui"

# Seu ID numérico do Telegram para o bot só responder a você.
# Para descobrir seu ID, envie uma mensagem para o bot @userinfobot no Telegram.
ADMIN_CHAT_ID="seu_chat_id_numerico"

# ------------------------------------------------------------------------------
# 2. RECONHECIMENTO DE VOZ (Groq Whisper API - Gratuita)
# ------------------------------------------------------------------------------
# Crie uma conta gratuita em https://console.groq.com e gere uma API Key.
# O Groq transcreve áudio com o modelo whisper-large-v3 em ~200ms sem custo.
GROQ_KEY="gsk_sua_chave_groq_aqui"

# ------------------------------------------------------------------------------
# 3. CÉREBRO DE IA (Google Gemini via Antigravity CLI ou API)
# ------------------------------------------------------------------------------
# Por padrão, no Linux o Jarvis utiliza o comando `agy` autenticado na sua conta Google.
# Se estiver no Windows ou preferir usar chave direta, configure o caminho ou modelo.
AGY_PATH="/usr/local/bin/agy"
JARVIS_MODEL="gemini-2.0-flash"

# ------------------------------------------------------------------------------
# 4. CONFIGURAÇÕES DO ASSISTENTE & HARDWARE
# ------------------------------------------------------------------------------
# Nome do assistente e palavras de ativação
ASSISTANT_NAME="Jarvis"
WAKE_WORDS="jarvis,computador"

# Limiar de sensibilidade do microfone (RMS)
# Valores típicos: 100 a 400 (ajuste conforme o ruído do seu quarto)
MIC_THRESHOLD="200"

# Voz neural em português (Microsoft Edge TTS)
# Opções: pt-BR-AntonioNeural (masculina), pt-BR-FranciscaNeural (feminina)
TTS_VOICE="pt-BR-AntonioNeural"

# Host e Porta da Micro-API / Dashboard Web
API_HOST="0.0.0.0"
API_PORT="8000"
